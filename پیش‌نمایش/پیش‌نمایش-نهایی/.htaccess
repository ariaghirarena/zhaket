# بچرخون — پیش‌نمایش استاتیک روی cPanel
# نکته: هیچ بازنویسی مسیر لازم نیست؛ فایل‌ها مستقیم سرو می‌شوند.

AddDefaultCharset UTF-8
DirectoryIndex index.html

# فهرست پوشه‌ها نمایش داده نشود
Options -Indexes

# نوع فایل‌ها (برای هاست‌هایی که mime فونت را نمی‌شناسند)
<IfModule mod_mime.c>
  AddType font/ttf              .ttf
  AddType font/woff2            .woff2
  AddType application/javascript .js
  AddType text/css              .css
  AddType image/svg+xml         .svg
</IfModule>

# فشرده‌سازی
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# کش فونت و تصاویر (یت‌سکندهای ۳۰ روز)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/ttf            "access plus 30 days"
  ExpiresByType font/woff2          "access plus 30 days"
  ExpiresByType image/svg+xml       "access plus 30 days"
  ExpiresByType text/css            "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/html           "access plus 0 seconds"
</IfModule>
